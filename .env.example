# Climate Action School — environment variables
# Copy this file to .env and fill in your own values. Never commit .env.
# The game plays fully offline without a key (fallback content is used).

# Anthropic API key for the Auntie Green narrator / quiz generator.
# The server reads this ONLY. It is never sent to the browser and never logged.
ANTHROPIC_API_KEY=

# Optional: override the Claude model (default: claude-haiku-4-5)
ANTHROPIC_MODEL=claude-haiku-4-5

# Optional: shared storage for Class Mode and rate limits (Vercel KV / Upstash
# Redis). Vercel sets these automatically when you add an Upstash Redis store
# from the Marketplace. Without them, sessions live in server memory.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional: AI cost guards. When reached, the game uses fallback content.
# AI calls per IP address per 10 minutes:
AI_RATE_LIMIT_PER_IP=120
# AI calls per day across all players:
AI_DAILY_LIMIT=5000

# Optional: comma-separated origins allowed to call the API cross-origin.
# Leave empty: the game only needs same-origin access.
ALLOWED_ORIGINS=

# Optional: set to 1 only if the Express server runs behind a reverse proxy
# that sets X-Forwarded-For (Vercel is handled automatically).
TRUST_PROXY=

# Optional: server port (default: 3001)
PORT=3001
