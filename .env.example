# Climate Action School — environment variables
# Copy this file to .env and fill in your own values. Never commit .env.
# The game plays fully offline without a key (fallback content is used).

# Anthropic API key for the Auntie Green narrator / quiz generator.
# The server reads this ONLY. It is never sent to the browser and never logged.
ANTHROPIC_API_KEY=

# Optional: override the Claude model (default: claude-haiku-4-5)
ANTHROPIC_MODEL=claude-haiku-4-5

# Optional: server port (default: 3001)
PORT=3001
